; KAT Canonical Format
; Schema Version: 1
; Envelope Version: 1
;
; This file defines the structural schema of canonical KAT objects.
;
; Additional requirements such as deterministic CBOR encoding,
; collection ordering, semantic validation, reference-kind validation,
; and hashing are defined in canonical-format.md.

; ---------------------------------------------------------------------------
; Primitive Types
; ---------------------------------------------------------------------------

; UUID values use CBOR tag 37 and contain exactly 16 bytes.
uuid = #6.37(bstr .size 16)

; Immutable canonical objects are identified by SHA-256.
object-id = bstr .size 32

; Stable ontology identifiers.
type-id = tstr

; Human-readable names and descriptions.
name = tstr
description = tstr

; ---------------------------------------------------------------------------
; Property Values
; ---------------------------------------------------------------------------

; Schema version 1 property values intentionally exclude floating-point numbers.
property-value =
  null
  / bool
  / int
  / tstr
  / bstr
  / uuid
  / property-list
  / property-map

property-list = [
  * property-value
]

; Property map keys MUST be unique.
property-map = {
  * tstr => property-value
}

; ---------------------------------------------------------------------------
; Canonical Object
; ---------------------------------------------------------------------------

; Each object kind has an explicit envelope production.
;
; This prevents an object_kind value from being paired with the wrong
; payload structure.
;
; Envelope fields:
;
;   0 -> envelope_version
;   1 -> object_kind
;   2 -> schema_version
;   3 -> payload
;
; Current canonical objects use:
;
;   envelope_version = 1
;   schema_version   = 1
;
; Object kinds:
;
;   1 -> KnowledgeElementVersion
;   2 -> RelationshipVersion
;   3 -> ChangeRevision
;   4 -> SemanticState
;   5 -> OntologyVersion

canonical-object =
  knowledge-element-object
  / relationship-object
  / change-revision-object
  / semantic-state-object
  / ontology-version-object

knowledge-element-object = {
  0: 1,
  1: 1,
  2: 1,
  3: knowledge-element-version
}

relationship-object = {
  0: 1,
  1: 2,
  2: 1,
  3: relationship-version
}

change-revision-object = {
  0: 1,
  1: 3,
  2: 1,
  3: change-revision
}

semantic-state-object = {
  0: 1,
  1: 4,
  2: 1,
  3: semantic-state
}

ontology-version-object = {
  0: 1,
  1: 5,
  2: 1,
  3: ontology-version
}

; ---------------------------------------------------------------------------
; Knowledge Element Version
; ---------------------------------------------------------------------------

; Fields:
;
;   0 -> stable ElementId
;   1 -> ontology type identifier
;   2 -> lifecycle
;   3 -> semantic properties

knowledge-element-version = {
  0: uuid,
  1: type-id,
  2: lifecycle,
  3: property-map
}

; Lifecycle values:
;
;   0 -> active
;   1 -> deprecated
;   2 -> superseded

lifecycle =
  0
  / 1
  / 2

; ---------------------------------------------------------------------------
; Relationship Version
; ---------------------------------------------------------------------------

; Fields:
;
;   0 -> stable RelationshipId
;   1 -> source ElementId
;   2 -> ontology relationship type
;   3 -> target ElementId
;   4 -> relationship properties

relationship-version = {
  0: uuid,
  1: uuid,
  2: type-id,
  3: uuid,
  4: property-map
}

; ---------------------------------------------------------------------------
; Semantic State
; ---------------------------------------------------------------------------

; A SemanticState represents one complete accepted semantic composition
; of the repository.
;
; Fields:
;
;   0 -> OntologyVersion ObjectId
;   1 -> selected element mappings
;   2 -> selected relationship mappings
;
; element-state-entry values MUST be sorted by ElementId.
;
; relationship-state-entry values MUST be sorted by RelationshipId.
;
; Duplicate semantic IDs are invalid.

semantic-state = {
  0: object-id,
  1: [* element-state-entry],
  2: [* relationship-state-entry]
}

; ElementId -> KnowledgeElementVersion ObjectId

element-state-entry = [
  uuid,
  object-id
]

; RelationshipId -> RelationshipVersion ObjectId

relationship-state-entry = [
  uuid,
  object-id
]

; ---------------------------------------------------------------------------
; Ontology Version
; ---------------------------------------------------------------------------

; Fields:
;
;   0 -> stable OntologyId
;   1 -> element type definitions
;   2 -> relationship type definitions
;
; Element and relationship definitions MUST be sorted by type_id.
; Duplicate type identifiers are invalid.

ontology-version = {
  0: uuid,
  1: [* element-type-definition],
  2: [* relationship-type-definition]
}

; Fields:
;
;   0 -> stable textual type identifier
;   1 -> human-readable name

element-type-definition = {
  0: type-id,
  1: name
}

; Fields:
;
;   0 -> stable textual relationship identifier
;   1 -> human-readable name
;   2 -> allowed source element types
;   3 -> allowed target element types
;
; allowed-source-types and allowed-target-types MUST be sorted
; lexicographically by their UTF-8 representation.
;
; Duplicates are invalid.

relationship-type-definition = {
  0: type-id,
  1: name,
  2: allowed-source-types,
  3: allowed-target-types
}

allowed-source-types = [
  * type-id
]

allowed-target-types = [
  * type-id
]

; ---------------------------------------------------------------------------
; Change Revision
; ---------------------------------------------------------------------------

; A ChangeRevision is one immutable revision of a logical Change.
;
; Fields:
;
;   0 -> stable ChangeId
;   1 -> base SemanticState ObjectIds
;   2 -> resulting SemanticState ObjectId
;   3 -> ordered semantic operations
;   4 -> causal ChangeRevision dependencies
;   5 -> optional human-readable description
;
; base_states contains at least one state.
;
; KAT v0.2 accepted publication uses one base state.
; The schema structurally permits multiple base-state references for future composition or merge semantics.
;
; When multiple base states are present, they MUST be sorted lexicographically
; by raw ObjectId bytes.
;
; Dependencies are set-like and MUST be sorted lexicographically by raw ObjectId bytes.
; Duplicate dependencies are invalid.
;
; Operation order is semantic and MUST NOT be changed.

change-revision = {
  0: uuid,
  1: [1* object-id],
  2: object-id,
  3: [1* operation],
  4: [* object-id],
  ? 5: description
}

; ---------------------------------------------------------------------------
; Operations
; ---------------------------------------------------------------------------

; Operations use tagged arrays.
;
; Operation identifiers:
;
;   1 -> CreateElement
;   2 -> UpdateElement
;   3 -> DeprecateElement
;   4 -> Link
;   5 -> Unlink
;   6 -> SupersedeElement
;   7 -> AccountArtifact

operation =
  create-element
  / update-element
  / deprecate-element
  / link
  / unlink
  / supersede
  / account-artifact

; ---------------------------------------------------------------------------
; CreateElement
; ---------------------------------------------------------------------------

; Fields:
;
;   0 -> operation kind = 1
;   1 -> new KnowledgeElementVersion ObjectId

create-element = [
  1,
  object-id
]

; ---------------------------------------------------------------------------
; UpdateElement
; ---------------------------------------------------------------------------

; Fields:
;
;   0 -> operation kind = 2
;   1 -> stable ElementId
;   2 -> expected current KnowledgeElementVersion ObjectId
;   3 -> new KnowledgeElementVersion ObjectId

update-element = [
  2,
  uuid,
  object-id,
  object-id
]

; ---------------------------------------------------------------------------
; DeprecateElement
; ---------------------------------------------------------------------------

; Fields:
;
;   0 -> operation kind = 3
;   1 -> stable ElementId
;   2 -> expected current KnowledgeElementVersion ObjectId
;   3 -> new deprecated KnowledgeElementVersion ObjectId

deprecate-element = [
  3,
  uuid,
  object-id,
  object-id
]

; ---------------------------------------------------------------------------
; Link
; ---------------------------------------------------------------------------

; Fields:
;
;   0 -> operation kind = 4
;   1 -> new RelationshipVersion ObjectId

link = [
  4,
  object-id
]

; ---------------------------------------------------------------------------
; Unlink
; ---------------------------------------------------------------------------

; Fields:
;
;   0 -> operation kind = 5
;   1 -> stable RelationshipId
;   2 -> expected current RelationshipVersion ObjectId

unlink = [
  5,
  uuid,
  object-id
]

; ---------------------------------------------------------------------------
; SupersedeElement
; ---------------------------------------------------------------------------

; Fields:
;
;   0 -> operation kind = 6
;   1 -> existing ElementId
;   2 -> expected existing KnowledgeElementVersion ObjectId
;   3 -> replacement ElementId
;   4 -> replacement KnowledgeElementVersion ObjectId
;   5 -> superseding RelationshipVersion ObjectId

supersede = [
  6,
  uuid,
  object-id,
  uuid,
  object-id,
  object-id
]

; ---------------------------------------------------------------------------
; AccountArtifact
; ---------------------------------------------------------------------------

; Fields:
;
;   0 -> operation kind = 7
;   1 -> artifact ElementId
;   2 -> non-empty list of relationship baseline reconciliations

account-artifact = [
  7,
  uuid,
  [1* relationship-reconciliation]
]

; Reconciliation entries MUST be strictly sorted lexicographically by the
; canonical 16-byte UUID representation of relationship_id.
; Duplicate relationship_id entries within reconciliations are invalid.
relationship-reconciliation = [
  uuid,
  object-id,
  uuid,
  object-id
]
