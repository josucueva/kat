#compdef kat

autoload -U is-at-least

_kat() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_kat_commands" \
"*::: :->kat" \
&& ret=0
    case $state in
    (kat)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:kat-command-$line[1]:"
        case $line[1] in
            (init)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(create)
_arguments "${_arguments_options[@]}" : \
'--title=[Title of the knowledge element]:TITLE:_default' \
'--description=[Optional detailed description]:DESCRIPTION:_default' \
'-h[Print help]' \
'--help[Print help]' \
':element_type -- Type of element to create (e.g. requirement, constraint, design-decision, implementation, artifact):_default' \
&& ret=0
;;
(update)
_arguments "${_arguments_options[@]}" : \
'--title=[New title for the element]:TITLE:_default' \
'--description=[New description for the element]:DESCRIPTION:_default' \
'-h[Print help]' \
'--help[Print help]' \
':element_id -- Element ID (UUID) to update:_default' \
&& ret=0
;;
(deprecate)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':element_id -- Element ID (UUID) to deprecate:_default' \
&& ret=0
;;
(supersede)
_arguments "${_arguments_options[@]}" : \
'--title=[Title for the replacement element]:TITLE:_default' \
'--description=[Optional detailed description for the replacement element]:DESCRIPTION:_default' \
'-h[Print help]' \
'--help[Print help]' \
':existing_element_id -- Existing element ID (UUID) to supersede:_default' \
':replacement_type -- Replacement element type (e.g. requirement, design-decision):_default' \
&& ret=0
;;
(link)
_arguments "${_arguments_options[@]}" : \
'--description=[Optional detailed description]:DESCRIPTION:_default' \
'-h[Print help]' \
'--help[Print help]' \
':relationship_type -- Relationship type (e.g. addresses, depends-on, derived-from, guides, motivates, realizes, represents, restricts, validates):_default' \
':source_element_id -- Source element ID (UUID):_default' \
':target_element_id -- Target element ID (UUID):_default' \
&& ret=0
;;
(unlink)
_arguments "${_arguments_options[@]}" : \
'--description=[Optional detailed description]:DESCRIPTION:_default' \
'-h[Print help]' \
'--help[Print help]' \
':relationship_id -- Relationship ID (UUID) to remove:_default' \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':element_id -- Element ID (UUID) to display:_default' \
&& ret=0
;;
(history)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(trace)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':element_id -- Target element ID (UUID) to trace:_default' \
&& ret=0
;;
(impact)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':element_id -- Target element ID (UUID) to analyze:_default' \
&& ret=0
;;
(validate)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(artifacts)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_kat__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:kat-help-command-$line[1]:"
        case $line[1] in
            (init)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(create)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(update)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(deprecate)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(supersede)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(link)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(unlink)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(history)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(trace)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(impact)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(validate)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(artifacts)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_kat_commands] )) ||
_kat_commands() {
    local commands; commands=(
'init:Initialize a new KAT repository in the current directory' \
'create:Create a new knowledge element' \
'update:Update title or description of an existing active knowledge element' \
'deprecate:Mark an active knowledge element as Deprecated' \
'supersede:Supersede an existing knowledge element with a new replacement element' \
'link:Establish a semantic relationship between two elements' \
'unlink:Remove a relationship from the current accepted state' \
'show:Show detailed view of a resolved active knowledge element' \
'history:Reconstruct and display the accepted change revision graph' \
'trace:Trace a knowledge element back to its origin' \
'impact:Analyze potential impact and consequences of changing an element' \
'validate:Run mechanical consistency validation across the current accepted state' \
'artifacts:Evaluate artifact accountability baselines against accepted state' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'kat commands' commands "$@"
}
