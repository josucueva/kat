(( $+functions[_kat_commands] )) ||
_kat_commands() {
    local commands; commands=(
'status:Show accepted repository state and current draft status' \
'context:Retrieve bounded semantic development context around elements' \
'author:Stage a semantic Change from declarative JSON' \
'check:Check consistency, evidence, accountability, and graph quality' \
'commit:Publish the current draft Change' \
'abort:Discard the current draft Change' \
'list:List knowledge elements in the current accepted state' \
'show:Inspect a resolved knowledge element' \
'history:Show accepted Change history' \
'trace:Trace an element to its semantic origin' \
'impact:Analyze consequences of changing an element' \
'artifacts:Evaluate artifact accountability baselines' \
'ontology:Discover semantic types and valid relationships' \
'validate:Run mechanical consistency validation' \
'create:Create a knowledge element (prefer kat author for normal authoring)' \
'update:Update an active knowledge element (prefer kat author for normal authoring)' \
'deprecate:Deprecate an active knowledge element (prefer kat author for normal authoring)' \
'supersede:Replace an element while preserving semantic history (prefer kat author for normal authoring)' \
'link:Establish a semantic relationship (prefer kat author for normal authoring)' \
'unlink:Remove a semantic relationship (prefer kat author for normal authoring)' \
'account:Re-baseline artifact accountability (prefer kat author for normal authoring)' \
'change:Manage draft Change transactions explicitly' \
'init:Initialize a KAT repository' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'kat commands' commands "$@"
}
