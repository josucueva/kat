            (status)
_arguments "${_arguments_options[@]}" : \
'--compact[Display compact single-line dashboard]' \
'--json[Output structured machine JSON envelope]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
